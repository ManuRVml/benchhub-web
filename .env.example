# BenchHub Web — environment variables (Vite).
# Copy to `.env.local`. Only variables prefixed with VITE_ are exposed to the browser — never put secrets here.

# API adapter:
#   mock = in-memory adapters, no BFF needed
#   http = relative /api/... calls, proxied by Vite to the BFF on http://localhost:3001
VITE_API_MODE=mock

# Mock identity (only used when VITE_API_MODE=mock):
# analyst_creator | explorer_viewer | explorer_integral | executive_viewer | executive_integral | none (signed out)
VITE_MOCK_ROLE=analyst_creator
# Grant the admin capability to the mock user: true | false
VITE_MOCK_ADMIN=false

# ── Tooling only (Playwright / scripts; not read by the app bundle) ──────────────────
# Port for the e2e dev server.
# E2E_PORT=5173
# Base URL of a running web+BFF stack for the stack e2e suite.
# STACK_URL=http://localhost:8088
