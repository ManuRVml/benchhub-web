{
  "name": "eco-comparator-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "prototype:render": "node tools/prototype-render/render.mjs",
    "prototype:check": "node tools/prototype-render/render.mjs --check",
    "verify": "pnpm contract:generate && pnpm contract:adapters && pnpm contract:mocks && pnpm contract:fixtures --check && pnpm i18n:inferred && pnpm tokens:check && pnpm lint && pnpm typecheck && pnpm test && vite build && pnpm check:http-bundle",
    "prepare": "husky",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "eslint --no-config-lookup --config tools/architecture/eslint.architecture.config.js --no-error-on-unmatched-pattern --max-warnings 0 src tools/arch-fixtures/valid",
    "check:architecture:selftest": "node tools/architecture/selftest.mjs",
    "check:http-bundle": "node tools/check-http-bundle.mjs",
    "gate:1": "node tools/check-gate1.mjs",
    "tokens:build": "node tools/tokens/build-theme.mjs",
    "tokens:check": "node tools/tokens/build-theme.mjs --check",
    "test:e2e": "playwright test --pass-with-no-tests",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir storybook-static",
    "contract:fixtures": "node tools/contracts/extract-examples.mjs",
    "contract:docs-sync": "node tools/contracts/sync-docs-from-bff.mjs",
    "contract:docs-check": "node tools/contracts/sync-docs-from-bff.mjs --check",
    "contract:generate": "node tools/contract/generate.mjs",
    "contract:check": "node tools/contract/check.mjs",
    "contract:adapters": "node tools/contract/check-adapters.mjs",
    "contract:mocks": "node tools/contract/check-mocks.mjs",
    "i18n:inferred": "node tools/check-i18n-inferred.mjs",
    "stack:up": "podman compose up -d --build",
    "stack:down": "podman compose down",
    "stack:logs": "podman compose logs -f",
    "test:e2e:stack": "playwright test -c playwright.stack.config.ts",
    "test:visual": "playwright test -c playwright.visual.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-playwright": "2.12.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lint-staged": "17.5.1",
    "msw": "2.15.0",
    "orval": "8.37.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": "eslint --max-warnings 0 --no-warn-ignored",
    "*.{ts,tsx,js,mjs,json,md}": "prettier --check"
  },
  "dependencies": {
    "@fontsource-variable/roboto": "5.3.0",
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-switch": "1.3.7",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "i18next": "26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-i18next": "17.0.15",
    "react-router": "8.4.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  }
}
